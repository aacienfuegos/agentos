# Montado como /home/worker/.ssh/config en backend y worker.
# StrictHostKeyChecking=no está limitado a este host de dev efímero
# (infra-dev-target se recrea en cada docker compose up), nunca usar
# este patrón contra infraestructura real.
Host infra-dev-target
    HostName infra-dev-target
    Port 2222
    User agentos
    IdentityFile /home/worker/.ssh/agentos_infra
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
